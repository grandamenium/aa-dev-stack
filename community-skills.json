{
  "_comment": "Community skills that installer.sh bundles via `claude plugin install` calls. Single source of truth for bundled dependencies.",

  "marketplaces_to_add": [
    { "spec": "anthropics/claude-plugins-official", "note": "frontend-design, claude-api, etc." },
    { "spec": "supabase/agent-skills", "note": "supabase + postgres-best-practices" },
    { "spec": "thepushkarp/handoff", "note": "session handoff + PreCompact hook" }
  ],

  "plugins_to_install": [
    { "name": "frontend-design", "marketplace": "claude-plugins-official", "ref": "stable" },
    { "name": "supabase", "marketplace": "supabase-agent-skills", "ref": "stable" },
    { "name": "postgres-best-practices", "marketplace": "supabase-agent-skills", "ref": "stable" },
    { "name": "handoff", "marketplace": "handoff", "ref": "stable" }
  ],

  "legacy_skills_to_install": [
    { "name": "taste-skill", "repo": "https://github.com/Leonxlnx/taste-skill.git", "path": "skills/taste-skill" },
    { "name": "claude-memory-skill", "repo": "https://github.com/hanfang/claude-memory-skill.git", "path": "skill/mem.md" },
    { "name": "dream-skill", "repo": "https://github.com/grandamenium/dream-skill.git", "path": "SKILL.md" },
    { "name": "local-ultrareview", "repo": "https://github.com/grandamenium/local-ultrareview.git", "path": "SKILL.md" },
    { "name": "m2c1", "repo": "https://github.com/grandamenium/m2c1.git", "path": "SKILL.md" }
  ],

  "non_plugin_components": [
    {
      "name": "GSD",
      "type": "external-cli",
      "install_command": "npm install -g get-shit-done-cc",
      "verify_command": "get-shit-done-cc --version",
      "note": "Small-project methodology spine. Used in Track 2 Modules 2-8."
    },
    {
      "name": "shadcn-mcp",
      "type": "mcp",
      "config_via": "/aa-connect shadcn",
      "note": "MCP only — not a plugin. Configured per-project on demand."
    },
    {
      "name": "21st-dev-magic-mcp",
      "type": "mcp",
      "config_via": "/aa-connect 21st-dev",
      "note": "Multi-variant UI generation MCP."
    }
  ]
}
